# meta-ego 설정 예시 — 복사해서 config.env 로 만들고 값을 채울 것.
# === API 등록 슬롯 (현재 미등록) ===
# 아래는 "등록만 가능"하게 비워 둔 자리다. 실제 키를 넣기 전까지는 아무 효과 없음.
# 기본 운전은 외부 API가 아니라 Muse(이 인스턴스)의 판단으로 exec 호출하는 방식이다.
EGO_API_PROVIDER=
EGO_API_KEY=
# === 브라우저 지정 (선택) ===
# CHROME_PATH=/home/hatch/.cache/ms-playwright/chromium-XXXX/chrome-linux/chrome
# EGO_LINUX_PROFILE=
# EGO_LINUX_HEADLESS=1
