# meta-muse-ultra 설정 예시 — 복사해서 config.env 로 만들고 값을 채울 것.
# 모든 값은 선택이다. 비워 두면 ub-config.sh가 환경에서 자동 해석한다:
#   Chromium: Playwright 캐시의 최신 chromium-* 리비전 → PATH의 chrome/chromium
#   프록시:   HTTPS_PROXY 등 표준 환경변수 → 없으면 직접 연결
#   프록시 CA: 없으면 NSS DB 준비 단계를 건너뜀
# === API 등록 슬롯 (현재 미등록) ===
# 아래는 "등록만 가능"하게 비워 둔 자리다. 실제 키를 넣기 전까지는 아무 효과 없음.
# 기본 운전은 외부 API가 아니라 Muse(이 인스턴스)의 판단으로 exec 호출하는 방식이다.
MUSE_ULTRA_API_PROVIDER=
MUSE_ULTRA_API_KEY=
# === 브라우저 지정 (선택) ===
# CHROME_PATH=/path/to/chrome-wrapper.sh   # 데몬이 실행할 래퍼/실행 파일. 기본값: 이 트리의 chrome-wrapper.sh
# MUSE_ULTRA_CHROME=/path/to/chrome       # 실제 Chromium 바이너리를 직접 지정할 때만 (자동 탐지 대체)
# MUSE_ULTRA_PROFILE=/path/to/profile    # 기본값: <트리>/profile
# MUSE_ULTRA_HEADLESS=1
# === 프록시 (선택) ===
# MUSE_ULTRA_PROXY=http://proxy-host:3128  # 우선순위: UB_PROXY > MUSE_ULTRA_PROXY > HTTPS_PROXY > 직접 연결
# MUSE_ULTRA_RELAY=auto                   # auto|1|0 — 로컬 socat 릴레이 사용 여부 (기본 auto: 비로컬 프록시+socat 있을 때만)
# UB_RELAY_PORT=18080                      # 릴레이 수신 포트
# UB_PROXY_CA=/path/to/proxy-ca.crt        # MITM 프록시의 CA가 있을 때만. 없으면 NSS 단계 생략 (구 HATCH_EGRESS_CA도 인식). none = CA 없음 강제
# === 상태 디렉터리 (선택) ===
# MUSE_ULTRA_STATE_DIR=/path/to/state     # 데몬 소켓·pid·로그. 기본값: ~/.local/share/muse-ultra-browser
# MUSE_ULTRA_CHROME_HOME=/path/to/home   # Chrome 프로세스 HOME(NSS DB 위치). 기본값: <트리>/chrome-home
# MUSE_ULTRA_CDP_PORT=19222              # Chrome 디버깅 포트 고정 (기본: 후보 목록에서 탐지)
